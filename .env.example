# Supabase project (Project Settings -> API). Use the DEVELOPMENT project's
# values for local dev/test; production deployment uses its own project.
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-public-key

# Optional: Supabase CLI target for `npm run db:push` (falls back to
# `supabase link`-ed project if unset).
# SUPABASE_DB_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Owner credentials used ONLY by scripts/seed-workbook.mjs (dev) and by
# tests/e2e/global-setup.ts to sign in and capture Playwright storageState.
# Never used by the app itself.
ARAWAN_OWNER_EMAIL=owner@example.com
ARAWAN_OWNER_PASSWORD=change-me
