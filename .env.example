# --- Local development (default; see README "Local development") ---------
# `npm run db:start` boots a local Supabase stack (Docker); its URL/anon key
# are fixed CLI defaults and its owner account is provisioned automatically
# by supabase/seed.sql on `npm run db:reset` -- no dashboard step needed.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODMgMTIwMTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
ARAWAN_OWNER_EMAIL=owner@arawan.local
ARAWAN_OWNER_PASSWORD=arawan-local-dev

# --- Hosted project (production; see README "Hosted project") -------------
# Uncomment and fill in from Project Settings -> API to point every command
# above at a real Supabase project instead. `npm run db:push` refuses to run
# against it (scripts/guard-remote.mjs) unless ARAWAN_ALLOW_PROD=1 is set --
# this is deliberate, not a bug.
# NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NUXT_PUBLIC_SUPABASE_KEY=your-anon-public-key
# SUPABASE_DB_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# ARAWAN_OWNER_EMAIL=owner@example.com
# ARAWAN_OWNER_PASSWORD=change-me
